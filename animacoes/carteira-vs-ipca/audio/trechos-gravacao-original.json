[
 {
  "ini": 0.963,
  "fim": 2.596,
  "texto": "Minha croteira começou no vermelho"
 },
 {
  "ini": 3.281,
  "fim": 3.681,
  "texto": "Hoje..."
 },
 {
  "ini": 4.067,
  "fim": 5.793,
  "texto": "ela rende quase o dobro da inflação"
 },
 {
  "ini": 6.345,
  "fim": 7.602,
  "texto": "mas isso é bom ou ruim?"
 },
 {
  "ini": 8.424,
  "fim": 13.078,
  "texto": "Para responder, você precisa saber quanto uma carteira diversificada rende de verdade."
 },
 {
  "ini": 13.905,
  "fim": 15.01,
  "texto": "e quase ninguém sabe."
 },
 {
  "ini": 15.36,
  "fim": 21.179,
  "texto": "Em um ano, uma carteira bem montada, com renda fixa, ações fundos imobiliários e um pouco de exterior,"
 },
 {
  "ini": 21.853,
  "fim": 23.586,
  "texto": "rende média uns 10%."
 },
 {
  "ini": 24.326,
  "fim": 25.706,
  "texto": "10.000 virou 11.000."
 },
 {
  "ini": 26.103,
  "fim": 27.009,
  "texto": "Parece pouco, né?"
 },
 {
  "ini": 27.721,
  "fim": 29.24,
  "texto": "e tem ano que fica no negativo."
 },
 {
  "ini": 29.676,
  "fim": 30.669,
  "texto": "A minha ficou também."
 },
 {
  "ini": 31.259,
  "fim": 33.211,
  "texto": "em dois anos, uns 20%."
 },
 {
  "ini": 34.04,
  "fim": 34.919,
  "texto": "Agora olha a minha."
 },
 {
  "ini": 35.92,
  "fim": 36.927,
  "texto": "23"
 },
 {
  "ini": 37.242,
  "fim": 38.664,
  "texto": "0,3%."
 },
 {
  "ini": 39.056,
  "fim": 40.432,
  "texto": "um pouco acima do esperado."
 },
 {
  "ini": 40.948,
  "fim": 41.731,
  "texto": "Nada de milagre"
 },
 {
  "ini": 42.422,
  "fim": 44.401,
  "texto": "carteira montada e paciência."
 },
 {
  "ini": 45.323,
  "fim": 46.924,
  "texto": "Só que o número sozinho engana."
 },
 {
  "ini": 47.306,
  "fim": 49.15,
  "texto": "A régua acerta em inflação."
 },
 {
  "ini": 49.463,
  "fim": 50.06,
  "texto": "O IPCA."
 },
 {
  "ini": 51.074,
  "fim": 55.855,
  "texto": "É ele que mede quanto seu dinheiro perde de valor no mercado, na gasolina, no aluguel."
 },
 {
  "ini": 56.704,
  "fim": 60.036,
  "texto": "No mesmo período, o IPCA subiu 12,6%."
 },
 {
  "ini": 60.604,
  "fim": 62.693,
  "texto": "eu fiz 23,3."
 },
 {
  "ini": 63.12,
  "fim": 63.769,
  "texto": "quase o dobro."
 },
 {
  "ini": 64.72,
  "fim": 66.472,
  "texto": "E aqui é onde fica interessante."
 },
 {
  "ini": 67.138,
  "fim": 71.012,
  "texto": "em 5 anos, a mesma carteira fez um 60%."
 },
 {
  "ini": 71.454,
  "fim": 74.089,
  "texto": "10 mil viraram quase 16."
 },
 {
  "ini": 74.792,
  "fim": 75.796,
  "texto": "em 10 anos."
 },
 {
  "ini": 76.299,
  "fim": 78.172,
  "texto": "mais de 150%."
 },
 {
  "ini": 78.899,
  "fim": 80.746,
  "texto": "10 mil viram 25 mil."
 },
 {
  "ini": 81.213,
  "fim": 82.883,
  "texto": "a inflação nesse tempo."
 },
 {
  "ini": 83.407,
  "fim": 87.51,
  "texto": "Evolução 55%. Os primeiros anos parecem lentos."
 },
 {
  "ini": 87.95,
  "fim": 88.943,
  "texto": "Isso é verdade."
 },
 {
  "ini": 89.781,
  "fim": 91.669,
  "texto": "mas é no final que os juros sobem."
 },
 {
  "ini": 92.472,
  "fim": 94.343,
  "texto": "e os joros sobre joros aparecem."
 },
 {
  "ini": 94.808,
  "fim": 98.747,
  "texto": "A diferença entre quem chega lá e quem desiste no caminho não é sorte."
 },
 {
  "ini": 99.315,
  "fim": 100.992,
  "texto": "é quem sabe o que esperar."
 },
 {
  "ini": 101.663,
  "fim": 103.121,
  "texto": "e a saber o que esperar."
 },
 {
  "ini": 103.798,
  "fim": 107.822,
  "texto": "Quem acha que vai dobrar em um ano, larga tudo no primeiro mês no vermelho."
 },
 {
  "ini": 108.668,
  "fim": 109.931,
  "texto": "Eu quase larguei."
 },
 {
  "ini": 110.609,
  "fim": 111.583,
  "texto": "Então te pergunto."
 },
 {
  "ini": 112.088,
  "fim": 115.849,
  "texto": "Você se sente preparado para planejar a sua liberdade financeira?"
 },
 {
  "ini": 116.715,
  "fim": 118.533,
  "texto": "ou ainda nem sabe a sua carteira."
 },
 {
  "ini": 119.661,
  "fim": 122.413,
  "texto": "ou ainda nem sabe se a sua carteira está batendo a inflação."
 },
 {
  "ini": 122.882,
  "fim": 125.459,
  "texto": "Comenta a liberdade que eu te mando a tabela completa."
 }
